# --- ReviewKit env (placeholders only, never commit real secrets) ---

# Clerk (dashboard authentication) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Postgres (persistence) — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side encryption for saved AI keys (PASSPHRASE, 32+ chars). Required to save keys.
ENCRYPTION_SECRET=

# GitHub App (PR reviews) — see docs/github-app.md
GITHUB_APP_ID=
# PEM private key, either multiline or base64-encoded single line
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# App slug for the "Install App" button, e.g. reviewkit-bot
GITHUB_APP_SLUG=

# AI provider endpoint (server-controlled; keys are per-account in Settings).
# Default is OpenCode Zen (OpenAI-compatible). See docs/ai-providers.md.
AI_PROVIDER_BASE_URL=https://opencode.ai/zen/v1

# Worker poll interval in ms (default 5000)
WORKER_POLL_MS=5000

# Local test mode: allow clearly-labeled SIMULATED reviews without GitHub (never real results).
# REVIEWKIT_LOCAL_TEST=1
