# --- DiffFox env (placeholders only, never commit real keys) ---
# Secret used to encrypt a remembered API key (32+ chars). Required to enable "Remember my key".
ENCRYPTION_SECRET=
# Optional: comma-separated allowed origins for server actions (default same-origin)
# ALLOWED_ORIGINS=
# Data directory for the JSON store + job queue (default ./data).
# On serverless (Vercel/Lambda) the app dir is read-only: only /tmp is writable
# (ephemeral). For durable storage, self-host (Docker/VPS) instead.
# DATA_DIR=./data
# Worker poll interval in ms (default 2000)
# WORKER_POLL_MS=2000
